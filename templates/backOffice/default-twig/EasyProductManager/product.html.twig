{# Quick "default price" editor, loaded in the EasyProductManager list modal.

   Migration Thelia 3: this screen used to render a Thelia FormView obtained from
   AbstractCrudController::hydrateObjectForm(), a method that left the core together with
   the concrete admin ProductController (journal D-008); the core ProductModificationForm
   is gone too. The target action reads plain request parameters and validates no token,
   so the controller now prepares the current values in `fields` and the inputs below are
   named exactly as that action expects. Taxed prices are computed in the browser and
   ignored by the action, hence they have no server-side counterpart. #}
{% if not is_granted('VIEW', 'admin.product') %}
    {{ 'Sorry, you are not allowed to perform this action.'|trans }}
{% else %}
<div class="form-container" data-testid="easy-product-manager-product">
    {% if not has_at_least_one_combination %}
        <form action="{{ path('admin.product.combination.defaut-price.update') }}" method="post" class="clearfix"
              data-testid="easy-product-manager-price-form">
            <input type="hidden" name="product_id" value="{{ product_id }}">
            <input type="hidden" name="current_tab" value="prices">
            <input type="hidden" name="product_sale_element_id" value="{{ default_product_sale_element_id }}">
            <input type="hidden" name="isdefault" value="1">
            <input type="hidden" name="reference" value="{{ fields.reference }}">
            <input type="hidden" name="currency" value="{{ edit_currency_id }}">
            <input type="hidden" name="tax_rule" value="{{ fields.tax_rule }}">

            <p class="title title-without-tabs">{{ 'Pricing'|trans({}, 'bo.default') }}</p>
            <p>{{ 'The default pricing is used when no combination is defined.'|trans({}, 'bo.default') }}</p>

            <div class="row">
                {# Pricing #}
                <div class="col-md-4">
                    <div class="card card-body mb-3">
                        <p class="title title-without-tabs">{{ 'Pricing'|trans({}, 'bo.default') }}</p>

                        {% if current_currency_is_default %}
                            <input type="hidden" name="use_exchange_rate" value="0">
                        {% else %}
                            <div class="mb-3 form-check">
                                <input type="checkbox" class="form-check-input use_exchange_rate_box"
                                       id="use_exchange_rate"
                                       data-pse-id="{{ default_product_sale_element_id }}"
                                       name="use_exchange_rate" value="1"
                                       {{ fields.use_exchange_rate ? 'checked' : '' }}>
                                <label class="form-check-label" for="use_exchange_rate">{{ 'Use the currency exchange rate'|trans({}, 'bo.default') }}</label>
                            </div>
                        {% endif %}

                        <div class="mb-3">
                            <label for="price_without_tax" class="form-label">{{ 'Product price excluding taxes'|trans({}, 'bo.default') }} :</label>
                            <div class="input-group">
                                <input data-pse-id="{{ default_product_sale_element_id }}"
                                       data-price-type="price-without-tax" data-rel-price="price_with_tax"
                                       type="text" id="price_without_tax" required="required" name="price"
                                       class="price_field automatic_price_field form-control"
                                       value="{{ fields.price }}"
                                       placeholder="{{ 'Price excl. taxes'|trans({}, 'bo.default') }}">
                                <span class="input-group-text">{{ currency_symbol }}</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="price_with_tax" class="form-label">{{ 'Product price including taxes'|trans({}, 'bo.default') }} :</label>
                            <div class="input-group">
                                <input data-pse-id="{{ default_product_sale_element_id }}"
                                       data-price-type="price-with-tax" data-rel-price="price_without_tax"
                                       type="text" id="price_with_tax" class="price_field automatic_price_field form-control"
                                       value="" placeholder="{{ 'Price incl. taxes'|trans({}, 'bo.default') }}">
                                <span class="input-group-text">{{ currency_symbol }}</span>
                            </div>
                        </div>
                    </div>
                </div>

                {# Stock #}
                <div class="col-md-4">
                    <div class="card card-body mb-3">
                        <p class="title title-without-tabs">{{ 'Stock'|trans({}, 'bo.default') }}</p>

                        <div class="mb-3">
                            <label class="form-label" for="ean_code">{{ 'EAN Code'|trans({}, 'bo.default') }} :</label>
                            <input type="text" id="ean_code" name="ean_code" class="form-control"
                                   value="{{ fields.ean_code }}"
                                   placeholder="{{ 'Product EAN Code'|trans({}, 'bo.default') }}">
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="weight">{{ 'Weight'|trans({}, 'bo.default') }} :</label>
                            <div class="input-group">
                                <input type="text" id="weight" name="weight" class="form-control"
                                       value="{{ fields.weight }}"
                                       placeholder="{{ 'Product weight'|trans({}, 'bo.default') }}">
                                <span class="input-group-text">{{ 'Kg'|trans({}, 'bo.default') }}</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="quantity">{{ 'Quantity'|trans({}, 'bo.default') }} :</label>
                            <input type="text" id="quantity" required="required" name="quantity" class="form-control"
                                   value="{{ fields.quantity }}"
                                   placeholder="{{ 'Current quantity'|trans({}, 'bo.default') }}">
                        </div>
                    </div>
                </div>

                {# Promotion #}
                <div class="col-md-4">
                    <div class="card card-body mb-3">
                        <p class="title title-without-tabs">{{ 'Promotion'|trans({}, 'bo.default') }}</p>

                        <div class="mb-3">
                            <label for="sale_price_without_tax" class="form-label">{{ 'Sale price excluding taxes'|trans({}, 'bo.default') }} :</label>
                            <div class="input-group">
                                <input data-pse-id="{{ default_product_sale_element_id }}"
                                       data-price-type="sale-price-without-tax" data-rel-price="sale_price_with_tax"
                                       type="text" id="sale_price_without_tax" required="required" name="sale_price"
                                       class="price_field automatic_price_field form-control"
                                       value="{{ fields.sale_price }}"
                                       placeholder="{{ 'Product price'|trans({}, 'bo.default') }}">
                                <span class="input-group-text">{{ currency_symbol }}</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="sale_price_with_tax" class="form-label">{{ 'Sale price incl. taxes'|trans({}, 'bo.default') }} :</label>
                            <div class="input-group">
                                <input data-pse-id="{{ default_product_sale_element_id }}"
                                       data-price-type="sale-price-with-tax" data-rel-price="sale_price_without_tax"
                                       type="text" id="sale_price_with_tax" class="price_field automatic_price_field form-control"
                                       value="" placeholder="{{ 'Sale price incl. taxes'|trans({}, 'bo.default') }}">
                                <span class="input-group-text">{{ currency_symbol }}</span>
                            </div>
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="onsale" name="onsale" value="1"
                                   {{ fields.onsale ? 'checked' : '' }}>
                            <label class="form-check-label" for="onsale">{{ 'This product is on sale'|trans({}, 'bo.default') }}</label>
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="isnew" name="isnew" value="1"
                                   {{ fields.isnew ? 'checked' : '' }}>
                            <label class="form-check-label" for="isnew">{{ 'This product is new'|trans({}, 'bo.default') }}</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-success" data-testid="easy-product-manager-price-save">
                    <i class="bi bi-save" aria-hidden="true"></i> {{ 'Save'|trans }}
                </button>
            </div>
        </form>
    {% else %}
        <div class="alert alert-info">
            {{ 'This product has combinations. Please edit prices from the product page.'|trans({}, 'easyproductmanager') }}
            <a href="{{ path('admin.products.update', {product_id: product_id}) }}" class="btn btn-primary btn-sm">{{ 'Edit product'|trans({}, 'easyproductmanager') }}</a>
        </div>
    {% endif %}
</div>

<script>
    (function () {
        'use strict';

        var editCurrencyId = {{ edit_currency_id }};
        var productId = {{ product_id }};

        function setFieldsReadonly(readonly) {
            document.querySelectorAll('.price_field').forEach(function (el) {
                el.readOnly = readonly;
            });
        }

        document.querySelectorAll('.use_exchange_rate_box').forEach(function (box) {
            box.addEventListener('change', function () {
                var pseId = this.dataset.pseId;
                if (this.checked) {
                    setFieldsReadonly(true);
                    var params = new URLSearchParams({
                        product_sale_element_id: pseId,
                        currency_id: editCurrencyId
                    });
                    fetch('/admin/product/load-converted-prices?' + params.toString(), {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (json) {
                        [
                            ['price-with-tax', json.price_with_tax],
                            ['price-without-tax', json.price_without_tax],
                            ['sale-price-with-tax', json.sale_price_with_tax],
                            ['sale-price-without-tax', json.sale_price_without_tax]
                        ].forEach(function (pair) {
                            var el = document.querySelector(
                                'input[data-pse-id="' + pseId + '"][data-price-type="' + pair[0] + '"]'
                            );
                            if (el) { el.value = pair[1]; }
                        });
                    })
                    .catch(function (err) {
                        alert('Failed to get converted prices. Please try again. (' + err + ')');
                    });
                } else {
                    setFieldsReadonly(false);
                }
            });
        });

        function update_price(price, price_type, dest_field_id) {
            var operation = '';
            if (price_type.indexOf('with-tax') !== -1) { operation = 'from_tax'; }
            else if (price_type.indexOf('without-tax') !== -1) { operation = 'to_tax'; }

            var params = new URLSearchParams({
                price: price,
                action: operation,
                product_id: productId
            });
            fetch('/admin/product/calculate-price?' + params.toString(), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function (r) { return r.json(); })
            .then(function (json) {
                var el = document.getElementById(dest_field_id);
                if (el) { el.value = json.result; }
            })
            .catch(function (err) {
                alert('Failed to get prices. Please try again. (' + err + ')');
            });
        }

        document.querySelectorAll('.automatic_price_field').forEach(function (field) {
            ['keyup', 'change'].forEach(function (evt) {
                field.addEventListener(evt, function () {
                    var price = this.value.replace(',', '.');
                    this.value = price;
                    update_price(price, this.dataset.priceType, this.dataset.relPrice);
                });
            });
        });

        // Seed the taxed fields from the untaxed values the server sent.
        document.querySelectorAll('input[data-price-type$="-without-tax"]').forEach(function (field) {
            if (field.value !== '') {
                update_price(field.value, field.dataset.priceType, field.dataset.relPrice);
            }
        });
    }());
</script>
{% endif %}
